<Window x:Class="AIQuotaBar.App.Views.QuotaToolTipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIQuotaBar Tooltip" Width="236" Height="112"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False" IsHitTestVisible="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="11">
    <Border Background="#25282E" CornerRadius="11" Padding="10,9,10,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="29" />
                <RowDefinition Height="21" />
                <RowDefinition x:Name="SecondaryQuotaRow" Height="21" />
                <RowDefinition Height="21" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TxtTitle" Text="Codex · Plus" Foreground="#F1F2F4"
                       VerticalAlignment="Top" Margin="0,2,5,0" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TxtUpdated" Grid.Column="1" Text="等待更新" FontSize="10"
                       Foreground="#8B9099" VerticalAlignment="Top" Margin="0,3,0,0" />
            <TextBlock x:Name="TxtPrimaryLabel" Grid.Row="1" Text="5 小时窗口" Foreground="#ABB0B9" TextTrimming="CharacterEllipsis" Margin="0,0,5,0" />
            <TextBlock x:Name="TxtPrimary" Grid.Row="1" Grid.Column="1" Text="--" Foreground="#27E4B0" HorizontalAlignment="Right" />
            <TextBlock x:Name="TxtSecondaryLabel" Grid.Row="2" Text="7 天窗口" Foreground="#ABB0B9" TextTrimming="CharacterEllipsis" Margin="0,0,5,0" />
            <TextBlock x:Name="TxtSecondary" Grid.Row="2" Grid.Column="1" Text="--" Foreground="#27E4B0" HorizontalAlignment="Right" />
            <TextBlock Grid.Row="3" Text="下次重置" Foreground="#ABB0B9" />
            <TextBlock x:Name="TxtReset" Grid.Row="3" Grid.Column="1" Text="--" Foreground="#D8DAE0" HorizontalAlignment="Right" />
            <TextBlock x:Name="TxtError" Grid.Row="4" Grid.ColumnSpan="2" Visibility="Collapsed"
                       Foreground="#F59E0B" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
        </Grid>
    </Border>
</Window>
